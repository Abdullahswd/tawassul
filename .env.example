# ============================================================
#  Eduroad Academic Platform - Environment Configuration
# ============================================================

# Database Connection (بيانات الاتصال بقاعدة البيانات على السيرفر)
DB_HOST="localhost"
DB_NAME="eduroad"
DB_USER="root"
DB_PASS=""
DB_CHARSET="utf8mb4"

# Application URL (رابط الموقع على السيرفر)
APP_URL="https://eduroad.tawassu.com"

# Google OAuth Credentials (بيانات تسجيل الدخول عبر Google)
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_REDIRECT_URI="https://eduroad.tawassu.com/google-callback.php"

# SMTP Mailer Settings (إعدادات خادم البريد الاحترافي)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_SECURE="tls"
MAIL_FROM_ADDRESS="your-email@gmail.com"
MAIL_FROM_NAME="منصة Eduroad"

